#!/bin/bash
set -eo pipefail
ROOT_DIR="$(cd "$(dirname "$0")/../../../" && pwd)"
if [ ! -f "$ROOT_DIR/.build-bundle/xvn.js" ]; then
  (cd $ROOT_DIR && nrx nrz-build --bins=xvn --outdir=".build-bundle" bundle > /dev/null 2>&1)
fi
NODE_OPTIONS="--no-warnings --enable-source-maps" node "$ROOT_DIR/.build-bundle/xvn.js" "$@"
