{
  "name": "@nrz/xdg",
  "description": "platform-specific app directories following XDG spec",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khulnasoft/nrz.git",
    "directory": "src/xdg"
  },
  "author": {
    "name": "KhulnaSoft, Ltd",
    "email": "support@khulnasoft.com",
    "url": "http://nrz.khulnasoft.com"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tap": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "license": "BSD-2-Clause-Patent",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "format": "prettier --write . --log-level warn --ignore-path ../../.prettierignore --cache",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --cache",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prepack": "tsc -p tsconfig.publish.json && ../../scripts/update-dist-exports.ts",
    "snap": "tap",
    "test": "tap",
    "posttest": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "tap": {
    "extends": "../../tap-config.yaml"
  },
  "prettier": "../../.prettierrc.js",
  "module": "./dist/index.js",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "bugs": [
    {
      "type": "link",
      "url": "https://github.com/khulnasoft/nrz/issues"
    }
  ],
  "homepage": "https://github.com/khulnasoft/nrz/tree/main/src/xdg#readme"
}
