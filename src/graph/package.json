{
  "name": "@nrz/graph",
  "description": "A library that helps understanding & expressing what happens on an install",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khulnasoft/nrz.git",
    "directory": "src/graph"
  },
  "author": "KhulnaSoft, Ltd <support@khulnasoft.com.com> (http://nrz.khulnasoft.com)",
  "dependencies": {
    "@nrz/cmd-shim": "workspace:*",
    "@nrz/dep-id": "workspace:*",
    "@nrz/dss-breadcrumb": "workspace:*",
    "@nrz/error-cause": "workspace:*",
    "@nrz/fast-split": "workspace:*",
    "@nrz/graph-run": "workspace:*",
    "@nrz/init": "workspace:*",
    "@nrz/output": "workspace:*",
    "@nrz/package-info": "workspace:*",
    "@nrz/package-json": "workspace:*",
    "@nrz/pick-manifest": "workspace:*",
    "@nrz/query": "workspace:*",
    "@nrz/rollback-remove": "workspace:*",
    "@nrz/run": "workspace:*",
    "@nrz/satisfies": "workspace:*",
    "@nrz/security-archive": "workspace:*",
    "@nrz/spec": "workspace:*",
    "@nrz/types": "workspace:*",
    "@nrz/nrz-json": "workspace:*",
    "@nrz/workspaces": "workspace:*",
    "path-scurry": "catalog:",
    "promise-call-limit": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tap": "catalog:",
    "tar": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "license": "BSD-2-Clause-Patent",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "format": "prettier --write . --log-level warn --ignore-path ../../.prettierignore --cache",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --cache",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prepack": "tsc -p tsconfig.publish.json && ../../scripts/update-dist-exports.ts",
    "snap": "tap",
    "test": "tap",
    "posttest": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "tap": {
    "extends": "../../tap-config.yaml"
  },
  "prettier": "../../.prettierrc.js",
  "module": "./src/index.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./src/index.ts"
      }
    },
    "./browser": {
      "import": {
        "default": "./src/browser.ts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/khulnasoft/nrz/issues"
  },
  "homepage": "https://github.com/khulnasoft/nrz/tree/main/src/graph#readme"
}