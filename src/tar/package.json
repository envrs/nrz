{
  "name": "@nrz/tar",
  "description": "An extremely limited and very fast tar extractor",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khulnasoft/nrz.git",
    "directory": "src/tar"
  },
  "author": "KhulnaSoft, Ltd <support@khulnasoft.com.com> (http://nrz.khulnasoft.com)",
  "dependencies": {
    "@nrz/error-cause": "workspace:*",
    "@nrz/types": "workspace:*",
    "rimraf": "catalog:",
    "tar": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/pacote": "catalog:",
    "@nrz/benchmark": "workspace:*",
    "eslint": "catalog:",
    "pacote": "catalog:",
    "prettier": "catalog:",
    "tap": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "license": "BSD-2-Clause-Patent",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "benchmark": "./scripts/benchmark.ts",
    "format": "prettier --write . --log-level warn --ignore-path ../../.prettierignore --cache",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --cache",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prepack": "tsc -p tsconfig.publish.json && ../../scripts/update-dist-exports.ts",
    "snap": "tap",
    "test": "tap",
    "posttest": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "tap": {
    "extends": "../../tap-config.yaml"
  },
  "prettier": "../../.prettierrc.js",
  "module": "./src/index.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./src/index.ts"
      }
    },
    "./clonefile": {
      "import": {
        "default": "./src/clonefile.ts"
      }
    },
    "./link-tree": {
      "import": {
        "default": "./src/link-tree.ts"
      }
    },
    "./pool": {
      "import": {
        "default": "./src/pool.ts"
      }
    },
    "./store-entry": {
      "import": {
        "default": "./src/store-entry.ts"
      }
    },
    "./store-index": {
      "import": {
        "default": "./src/store-index.ts"
      }
    },
    "./unpack": {
      "import": {
        "default": "./src/unpack.ts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/khulnasoft/nrz/issues"
  },
  "homepage": "https://github.com/khulnasoft/nrz/tree/main/src/tar#readme"
}
