{
  "name": "@nrz/registry-client",
  "description": "Fetch package artifacts and metadata from registries",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khulnasoft/nrz.git",
    "directory": "src/registry-client"
  },
  "author": "KhulnaSoft, Ltd <support@khulnasoft.com> (http://nrz.khulnasoft.com)",
  "dependencies": {
    "@nrz/cache": "workspace:*",
    "@nrz/cache-unzip": "workspace:*",
    "@nrz/error-cause": "workspace:*",
    "@nrz/keychain": "workspace:*",
    "@nrz/output": "workspace:*",
    "@nrz/types": "workspace:*",
    "@nrz/url-open": "workspace:*",
    "@nrz/user-agent": "workspace:*",
    "@nrz/xdg": "workspace:*",
    "cache-control-parser": "^2.0.6",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tap": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "license": "BSD-2-Clause-Patent",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "format": "prettier --write . --log-level warn --ignore-path ../../.prettierignore --cache",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --cache",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prepack": "tsc -p tsconfig.publish.json && ../../scripts/update-dist-exports.ts",
    "snap": "tap",
    "test": "tap",
    "posttest": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "tap": {
    "extends": "../../tap-config.yaml"
  },
  "prettier": "../../.prettierrc.js",
  "module": "./src/index.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./src/index.ts"
      }
    },
    "./cache-entry": {
      "import": {
        "default": "./src/cache-entry.ts"
      }
    },
    "./registry-error": {
      "import": {
        "default": "./src/registry-error.ts"
      }
    },
    "./store-root": {
      "import": {
        "default": "./src/store-root.ts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/khulnasoft/nrz/issues"
  },
  "homepage": "https://github.com/khulnasoft/nrz/tree/main/src/registry-client#readme"
}
